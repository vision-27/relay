{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "relay-context",
  "main": "index.ts",
  "compatibility_date": "2026-09-28",
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECTS",
        "class_name": "ProjectRoom"
      },
      {
        "name": "BUDGET",
        "class_name": "AccountBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProjectRoom"
      ]
    },
    {
      "tag": "v2-budget",
      "new_sqlite_classes": [
        "AccountBudget"
      ]
    }
  ],
  "observability": {
    "enabled": false
  },
  "workers_dev": true
}
